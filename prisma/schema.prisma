generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  googleTokens  Json?     // Google OAuth tokens: accessToken and refreshToken encrypted (lib/google/token-store.ts), the rest plain
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  sites         Site[]
  alerts        Alert[]
  apiKeys       ApiKey[]
  accessKeys    AccessKey[]
  settings      UserSettings?
  // Agency fork: client projects (lib/projects).
  projectsOwned Project[]
  memberships   Membership[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ API KEYS (BYOK) ============

model ApiKey {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "dataforseo" (login+password) | "google_pagespeed" | "bing" (single key)
  encryptedLogin    String?  // null for single-key providers like google_pagespeed
  encryptedPassword String   // holds the API key itself for single-key providers
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ============ ACCESS KEYS (read-only API and MCP) ============

// A key a user creates to read their own data through /api/v1 (lib/api-v1),
// which the MCP server uses. Only a SHA-256 hash of the key is stored; the
// key itself is shown once, when it is created. Revoking a key deletes it.
model AccessKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique // SHA-256 of the whole key, hex
  prefix     String    // the start of the key, to tell keys apart in Settings
  // Agency fork: "read" (GET only, the default and every key made before) or
  // "write" (also POST /api/v1/sites/{id}/positions and the push_positions tool).
  scope      String    @default("read")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // updated at most once a minute

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ USER SETTINGS ============

// What a user sets in Settings > Schedule and Settings > Alert webhook.
model UserSettings {
  userId             String   @id
  crawlScheduleDays  Int?     // days between scheduled crawls of each site; null: the server default, 0: off
  vitalsScheduleDays Int?     // the same for vitals checks
  webhookUrl         String?  // encrypted (lib/encryption.ts); null: no webhook
  webhookSecret      String?  // encrypted; signs every delivery
  mcpEnabled         Boolean  @default(false) // Settings > MCP: access keys work only while this is on
  alertEmailTo       String?  // Settings > Email alerts: recipients, comma-separated; null: none
  alertEmailEnabled  Boolean  @default(false) // fired alerts are emailed only while this is on
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ SITES ============

model Site {
  id          String   @id @default(cuid())
  userId      String
  domain      String   // e.g. "quilltab.app"
  gscProperty String?  // e.g. "sc-domain:quilltab.app"
  bingSite    String?  // e.g. "https://quilltab.app/" (Bing's own URL form)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords      Keyword[]
  pages         Page[]
  crawls        Crawl[]
  vitals        VitalsReport[]
  alerts        Alert[]
  savedKeywords SavedKeyword[]
  rankSnapshots RankSnapshot[]
  bingDaily     BingDaily[]
  bingWeekly    BingSearchWeekly[]
  jobs          Job[]
  // Agency fork: positions from rank trackers, imports and the write API (lib/rank-providers).
  rankEngines   ExternalRankEngine[]
  // Agency fork: the client project this site belongs to, if any (lib/projects).
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  journalEntries JournalEntry[]

  @@unique([userId, domain])
  @@index([projectId])
}

// ============ GSC DATA ============

model Keyword {
  id          String   @id @default(cuid())
  siteId      String
  query       String   // The search query
  date        DateTime // Date of the data point
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  page        String?  // Landing page URL
  device      String?  // DESKTOP, MOBILE, TABLET
  country     String?  // Country code

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

model Page {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, url, date])
  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ BING WEBMASTER DATA ============

/// Bing's daily grain: site traffic (GetRankAndTrafficStats) and crawler stats
/// (GetCrawlStats) share one row because both are keyed by (site, day).
/// Kept apart from Keyword/Page so no existing Google query changes meaning.
model BingDaily {
  id              String   @id @default(cuid())
  siteId          String
  date            DateTime
  clicks          Int?
  impressions     Int?
  crawledPages    Int?
  inIndex         Int?
  inLinks         Int?
  code2xx         Int?
  code301         Int?
  code302         Int?
  code4xx         Int?
  code5xx         Int?
  blockedByRobots Int?
  crawlErrors     Int?

  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
}

/// Bing's weekly grain: GetQueryStats and GetPageStats return the same contract
/// in buckets ending on a Friday, so `kind` distinguishes them.
model BingSearchWeekly {
  id                    String   @id @default(cuid())
  siteId                String
  kind                  String   // "query" | "page"
  key                   String   // the search query, or the page URL
  weekEnding            DateTime
  clicks                Int?     // null when Bing left the counter out
  impressions           Int?
  avgImpressionPosition Float?

  site                  Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, kind, key, weekEnding])
  @@index([siteId, kind, weekEnding])
}

// ============ SAVED KEYWORDS ============

model SavedKeyword {
  id        String   @id @default(cuid())
  siteId    String
  query     String
  notes     String?
  createdAt DateTime @default(now())

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query])
  @@index([siteId])
}

// ============ RANK TRACKING ============

model RankSnapshot {
  id          String   @id @default(cuid())
  siteId      String
  query       String
  position    Float
  clicks      Int      @default(0)
  impressions Int      @default(0)
  page        String?
  date        DateTime

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, query, date])
  @@index([siteId, date])
  @@index([siteId, query, date])
}

// ============ CRAWLER ============

model Crawl {
  id          String      @id @default(cuid())
  siteId      String
  status      CrawlStatus @default(PENDING)
  startedAt   DateTime?
  finishedAt  DateTime?
  pagesFound  Int         @default(0)
  issuesFound Int         @default(0)
  healthScore Int?        // 0-100
  maxPages    Int         @default(200)
  // Set when the crawl is created and each time it makes progress. A RUNNING
  // crawl that stops updating it was interrupted (#57).
  lastProgressAt DateTime?
  error       String?     // why a FAILED crawl failed

  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  issues      CrawlIssue[]
  auditPages  AuditPage[]
  auditLinks  AuditLink[]
  jobs        Job[]

  @@index([siteId, startedAt])
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ============ AUDIT PAGE DATA ============

model AuditPage {
  id              String  @id @default(cuid())
  crawlId         String
  url             String
  statusCode      Int
  redirectUrl     String?

  title           String?
  description     String?
  canonical       String?
  robotsMeta      String?

  h1Count         Int     @default(0)
  h1s             Json?   // Array of H1 text
  wordCount       Int     @default(0)

  imageCount      Int     @default(0)
  imagesMissingAlt Int    @default(0)

  internalLinks   Int     @default(0)
  externalLinks   Int     @default(0)

  hasSchema       Boolean @default(false)
  hreflangTags    Json?   // Array of hreflang values

  contentScore    Int     @default(0)  // 0-100
  contentHash     String? // SHA-256 of body text

  responseTimeMs  Int     @default(0)
  byteSize        Int     @default(0)
  // False when the page is noindex: meta robots/googlebot or X-Robots-Tag (#105).
  // Such a page is crawled and its links followed, but it is kept out of the
  // health score and the issues.
  indexable       Boolean @default(true)
  noindexSource   String? // "meta", "x-robots-tag" or both, comma-joined
  xRobotsTag      String? // the X-Robots-Tag header lines as received, newline-separated

  crawl           Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, url])
}

// ============ AUDIT LINK GRAPH ============

model AuditLink {
  id          String  @id @default(cuid())
  crawlId     String
  sourceUrl   String
  targetUrl   String
  anchorText  String?
  isInternal  Boolean @default(true)
  isNofollow  Boolean @default(false)
  statusCode  Int?

  crawl       Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId])
  @@index([crawlId, sourceUrl])
}

model CrawlIssue {
  id          String        @id @default(cuid())
  crawlId     String
  url         String
  type        IssueType
  severity    IssueSeverity
  message     String
  details     Json?         // Additional context

  crawl       Crawl         @relation(fields: [crawlId], references: [id], onDelete: Cascade)

  @@index([crawlId, type])
}

enum IssueType {
  BROKEN_LINK           // 404, 500, etc.
  REDIRECT              // 301, 302 chains
  MISSING_TITLE         // No <title> tag
  MISSING_DESCRIPTION   // No meta description
  DUPLICATE_TITLE       // Same title on multiple pages
  DUPLICATE_DESCRIPTION // Same description on multiple pages
  MISSING_H1            // No H1 heading
  MULTIPLE_H1           // More than one H1
  MISSING_ALT           // Images without alt text
  MISSING_CANONICAL     // No canonical tag
  MISSING_ROBOTS        // No robots.txt
  MISSING_SITEMAP       // No sitemap.xml
  MISSING_SCHEMA        // No structured data
  SLOW_PAGE             // Load time > 3s
  MIXED_CONTENT         // HTTP resources on HTTPS page
  LARGE_PAGE            // Page size > 3MB
}

enum IssueSeverity {
  CRITICAL
  WARNING
  INFO
}

// ============ CORE WEB VITALS ============

model VitalsReport {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  date        DateTime @default(now())
  device      String   // MOBILE or DESKTOP

  // Core Web Vitals
  lcp         Float?   // Largest Contentful Paint (seconds)
  fid         Float?   // First Input Delay (milliseconds)
  cls         Float?   // Cumulative Layout Shift (score)
  inp         Float?   // Interaction to Next Paint (milliseconds)

  // Performance
  perfScore   Int?     // 0-100 Lighthouse performance score
  speedIndex  Float?   // Speed Index (seconds)
  ttfb        Float?   // Time to First Byte (seconds)

  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, date])
  @@index([siteId, url, date])
}

// ============ ALERTS ============

model Alert {
  id          String     @id @default(cuid())
  userId      String
  siteId      String
  type        AlertType
  channel     AlertChannel
  config      Json       // Thresholds, webhook URL, etc.
  enabled     Boolean    @default(true)
  lastFired   DateTime?
  createdAt   DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

enum AlertType {
  TRAFFIC_DROP       // Clicks dropped > X%
  POSITION_CHANGE    // Keyword position changed > X
  NEW_404            // New broken links detected
  VITALS_DEGRADED    // Core Web Vitals got worse
  CRAWL_ISSUES       // New crawl issues detected
  NOINDEX_SITEWIDE   // Most fetched pages of the latest crawl are noindex
}

enum AlertChannel {
  EMAIL
  TELEGRAM
  WEBHOOK
  SLACK
}

// ============================================
// JOB QUEUE (lib/jobs)
// ============================================

// Background work: crawls, vitals checks, syncs, alert evaluation. Claimed by
// the app (WORKER_MODE=inline) or the worker process with FOR UPDATE SKIP
// LOCKED, retried with backoff, and taken back when the process running it
// stops sending heartbeats.
model Job {
  id          String    @id @default(cuid())
  siteId      String
  type        String    // a type registered in lib/jobs/handlers.ts
  status      JobStatus @default(QUEUED)
  source      String    // "manual" | "mcp" | "schedule" | "chain" | "site-added"
  priority    Int       @default(0) // higher runs first
  payload     Json?
  result      Json?
  attempts    Int       @default(0)
  maxAttempts Int
  runAt       DateTime  @default(now()) // not before
  activeKey   String?   @unique // "<type>:<siteId>" while QUEUED or RUNNING, null once finished
  lockedBy    String?   // id of the process running it
  lockedAt    DateTime?
  heartbeatAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  errorCode   String?   // e.g. REAUTH_REQUIRED, QUOTA_EXCEEDED
  crawlId     String?   // the crawl row of the latest attempt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  crawl       Crawl?    @relation(fields: [crawlId], references: [id], onDelete: SetNull)

  @@index([status, runAt])
  @@index([siteId, type, createdAt])
  @@index([crawlId])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// One row per process that processes jobs, so the app can tell whether
// anything picks up queued jobs. Holds no user data.
model WorkerHeartbeat {
  id         String   @id // the process id used in Job.lockedBy
  mode       String   // "inline" | "worker"
  hostname   String
  version    String
  startedAt  DateTime
  lastSeenAt DateTime

  @@index([lastSeenAt])
}


// The scheduler's own timestamps (lib/jobs/scheduler.ts). Holds no user data.
// "firstSeenAt:<type>": the first pass that could schedule that job type; a
// site's first scheduled crawl and vitals check are spread over the interval
// after it. "lastRunAt": the last scheduling pass, so processes share one.
model SchedulerState {
  key String   @id
  at  DateTime
}

// ============ EXTERNAL RANK TRACKING (agency fork) ============

// One search engine of one rank source, linked to a site. The source is a
// rank provider id (synced, e.g. "labrika": externalSiteId is the provider's
// project, externalEngineId its engine), "import" (a CSV uploaded in the UI)
// or a name a script pushes rows under through the write API. For the last
// two, externalSiteId is the label key and externalEngineId is
// "engine|region|device" in lower case.
model ExternalRankEngine {
  id               String    @id @default(cuid())
  siteId           String
  source           String    // a rank provider id, "import", or a pushed source name
  externalSiteId   String    // provider project id; label key for imported and pushed engines
  externalEngineId String    // provider engine id; "engine|region|device" for imported and pushed ones
  label            String    @default("") // a user label for imported and pushed engines
  host             String    // the project's host in the tracker, or the site's domain
  engine           String    // e.g. "Яндекс"
  region           String    // e.g. "Москва (ПК)"
  device           String    // "desktop" | "mobile"
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  site             Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  ranks            ExternalRank[]

  @@unique([siteId, source, externalSiteId, externalEngineId])
}

// One keyword on one check date of one engine. position null: checked, and
// the site was not within the depth the tracker checks (top 100 at most). A
// keyword the tracker did not check on a date has no row for that date.
model ExternalRank {
  id             String   @id @default(cuid())
  engineId       String
  keyword        String
  date           DateTime // the check date, UTC midnight
  position       Int?
  url            String?
  frequency      Int?
  frequencyExact Int?

  engine         ExternalRankEngine @relation(fields: [engineId], references: [id], onDelete: Cascade)

  @@unique([engineId, keyword, date])
  @@index([engineId, date])
}

// ============ CLIENT PROJECTS (agency fork) ============

// A client project above its sites (lib/projects): the passport, the brief
// and materials, tasks and a journal. Access is per Membership; the creator
// is its first owner. A site keeps its own owner (Site.userId) and works
// without a project.
model Project {
  id            String   @id @default(cuid())
  slug          String   @unique // a-z, 0-9 and -, used in URLs and by the agent sync
  name          String
  status        String   @default("client") // client | prospect | paused | archived
  testUrl       String?
  geo           String?
  language      String?
  searchEngines String[] @default([])
  cms           String?
  hosting       String?
  contacts      String?  // free text
  accessNotes   String?  // names of variables and where secrets live, never the secrets (lib/projects/secrets.ts)
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members       Membership[]
  sites         Site[]
  notes         ProjectNote[]
  files         ProjectFile[]
  journal       JournalEntry[]
  tasks         ProjectTask[]
  rankSettings  ProjectRankSettings?
  rankChecks    RankCheckRun[]
  budget        ProjectBudget?
  budgetPlan    BudgetPlanLine[]
  budgetEntries BudgetEntry[]

  @@index([ownerId])
}

model Membership {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   // owner | editor | viewer
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// A markdown note (brief, audience, chat summary, strategy). Each change keeps
// the version before it in ProjectNoteVersion; the oldest ones are pruned.
model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  kind      String   // brief | audience | chat | strategy | other
  title     String
  body      String   @default("")
  version   Int      @default(1)
  updatedBy String   // who wrote the current version: an email, plus the key name for the API
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions  ProjectNoteVersion[]

  @@unique([projectId, kind, title])
  @@index([projectId, updatedAt])
}

model ProjectNoteVersion {
  id        String   @id @default(cuid())
  noteId    String
  version   Int
  title     String
  body      String
  updatedBy String
  createdAt DateTime // when this version was written

  note      ProjectNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, version])
}

// An uploaded file. The bytes live on disk under UPLOADS_DIR/<projectId>/<storageName>;
// storageName is random, the original name is only shown and sent on download.
model ProjectFile {
  id          String   @id @default(cuid())
  projectId   String
  name        String   // the original file name, cleaned
  storageName String   @unique
  type        String   // the extension we accepted: pdf, docx, xlsx, txt, png ...
  mime        String   // the type we send, from the extension, never the browser's
  size        Int
  sha256      String
  category    String   @default("materials") // materials | chat
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, updatedAt])
}

model JournalEntry {
  id         String   @id @default(cuid())
  projectId  String
  date       DateTime // the day the work was done, UTC midnight
  text       String
  link       String?
  author     String
  authorKind String   @default("human") // human | agent (written with an access key)
  siteId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@index([projectId, updatedAt])
}

model ProjectTask {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  status      String    @default("todo") // todo | doing | review | done
  priority    String    @default("normal") // low | normal | high
  due         DateTime?
  assignee    String?
  notes       String?
  externalKey String?   // the caller's own id, so a sync can upsert without knowing ours
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalKey])
  @@index([projectId, updatedAt])
}

// ============ RANK SETTINGS AND BUDGET (agency fork) ============

// When and how a project's positions are checked. No row, or enabled false:
// nothing is started for the project (docs/agency/rank-settings-and-budget.md).
model ProjectRankSettings {
  projectId String   @id
  enabled   Boolean  @default(false)
  source    String   @default("none")   // a rank provider id, or "none"
  frequency String   @default("manual") // weekly | biweekly | monthly | manual
  engineIds String[] @default([])       // ExternalRankEngine ids of the project's sites that are checked
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// The usage log: one row per attempt to start a check of a project, started or not.
model RankCheckRun {
  id              String   @id @default(cuid())
  projectId       String
  provider        String
  trigger         String   // schedule | manual
  status          String   // started | partial | skipped | failed
  reason          String?  // why skipped or failed: no-cabinet-login, over-limit, no-engines, not-supported, error text
  engineIds       String[] @default([])
  details         Json?    // per engine: id, label, keywords, started, error
  estimatedChecks Int      @default(0) // keywords x engines that were started
  createdBy       String?
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([provider, createdAt])
}

// The monthly check limit and the price plan of one rank provider account, for the whole instance.
model RankProviderPlan {
  provider     String   @id
  monthlyLimit Int
  planName     String
  planPrice    Decimal  @db.Decimal(14, 2)
  planChecks   Int
  currency     String   @default("RUB")
  updatedBy    String?
  updatedAt    DateTime @updatedAt
}

model ProjectBudget {
  projectId  String   @id
  currency   String   @default("RUB") // RUB | USD
  categories String[] @default(["work", "services", "ads", "content", "links", "other"])
  updatedAt  DateTime @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// The monthly plan of one category. month "": every month; "YYYY-MM": that month only, over the default.
model BudgetPlanLine {
  id        String   @id @default(cuid())
  projectId String
  month     String   @default("")
  category  String
  amount    Decimal  @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month, category])
}

// A manual actual cost. Automatic service costs (rank checks) are computed from RankCheckRun, not stored.
model BudgetEntry {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime // UTC midnight
  category    String
  amount      Decimal  @db.Decimal(14, 2)
  note        String?
  externalKey String?  // the caller's own id, so a retry adds nothing twice
  author      String
  authorKind  String   @default("human") // human | agent
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, externalKey])
  @@index([projectId, date])
}
